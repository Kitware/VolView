# Base URL for DICOMWeb request. 
# If no variable found, DICOMWeb panel in data tab is hidden unless set in settings.
VITE_DICOM_WEB_URL=http://localhost:5173/dicom-web

# Display name of DICOMWeb host.
VITE_DICOM_WEB_NAME=ACME Hospital

# Error reporting URL for sentry.io.
VITE_SENTRY_DSN=

# Sentry environment label, such as production or development. Defaults to production.
VITE_SENTRY_ENVIRONMENT=

# VolView server remote URL
VITE_REMOTE_SERVER_URL=http://localhost:4014

# Controls the initial visibility of the Sample Data section.
VITE_SHOW_SAMPLE_DATA=true

# Optional Netlify Edge Function analytics. Set these in Netlify's Functions
# scope for the deployment contexts to track. Never use a VITE_ prefix for tokens.
GOATCOUNTER_SITE=
GOATCOUNTER_API_TOKEN=
